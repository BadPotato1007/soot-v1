[sub_resource type="Shader" id="Shader_floor"]
code = "shader_type canvas_item;
void fragment() {
    vec2 pos = floor(UV * vec2(320.0, 180.0));
    // 16x16 pixel white floor tiles with subtle grout lines
    vec2 tile = mod(pos, 16.0);
    vec3 col = vec3(0.95, 0.96, 0.97); // crisp white ceramic tile
    if (tile.x == 0.0 || tile.y == 0.0) {
        col = vec3(0.84, 0.86, 0.88); // subtle grout border
    }
    COLOR = vec4(col, 1.0);
}
"

